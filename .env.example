# Public URL of the store, used for canonical links, sitemap, structured data
# and the payment gateway's return address. Set it in production; leave it
# unset in development so the gateway returns to localhost.
# NEXT_PUBLIC_SITE_URL=https://peyman-elec.ir

# ZarinPal: leave ZARINPAL_SANDBOX unset (or "true") to use the test gateway.
# For real payments set ZARINPAL_SANDBOX=false and your 36-character merchant id.
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=

# SQLite file for orders. Defaults to ./data/peyman.db; keep it on a persistent disk.
DATABASE_PATH=

# Password for /admin (at least 8 characters). Admin is disabled when unset.
ADMIN_PASSWORD=

# Customer login (/account) sends a one-time code by SMS. Pick a provider and
# fill its keys; the OTP template is created and approved in its panel.
#   kavenegar  KAVENEGAR_API_KEY, KAVENEGAR_OTP_TEMPLATE (template with one %token%)
#   smsir      SMSIR_API_KEY, SMSIR_OTP_TEMPLATE_ID, SMSIR_OTP_PARAM (default CODE)
#   test       shows the code on the login page instead of sending it. Works
#              only on localhost; never use it on the public site.
# Leave SMS_PROVIDER empty to turn customer login off.
SMS_PROVIDER=
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=
SMSIR_OTP_PARAM=
